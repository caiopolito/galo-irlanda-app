{
  "name": "galo-irlanda",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "check:web": "npm run check -w apps/web && npm run typecheck -w apps/web",
    "dev:api": "dotnet run --project apps/api/src/GaloIrlanda.Api",
    "test:api": "dotnet test apps/api/GaloIrlanda.slnx",
    "test:web": "npm run test -w apps/web"
  }
}
